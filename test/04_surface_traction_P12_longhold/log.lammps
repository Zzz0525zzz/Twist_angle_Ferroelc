write_data      ${CASE}_prerelax.data pair ij
write_data      twist_bto_P12_longhold_prerelax.data pair ij
System init for write_data ...
write_restart   ${CASE}_prerelax.restart
write_restart   twist_bto_P12_longhold_prerelax.restart
System init for write_restart ...

# Reset displacement reference after pre-relaxation. The dump c_dis[*] will now
# measure displacement caused by ramp + P12 hold, not construction/pre-relaxation.
uncompute       dis
compute         dis all displace/atom

# ------------------------ DUMP FOR RAMP + LONG HOLD ONLY ----------------------------
dump            dload all custom ${DUMPINT} ${CASE}_Load.*.dump id mol type q x y z fx fy fz c_dis[1] c_dis[2] c_dis[3] c_dis[4] c_myKE c_myPE v_Mise
dump            dload all custom 5000 ${CASE}_Load.*.dump id mol type q x y z fx fy fz c_dis[1] c_dis[2] c_dis[3] c_dis[4] c_myKE c_myPE v_Mise
dump            dload all custom 5000 twist_bto_P12_longhold_Load.*.dump id mol type q x y z fx fy fz c_dis[1] c_dis[2] c_dis[3] c_dis[4] c_myKE c_myPE v_Mise
dump_modify     dload sort id

# Common thermostat and momentum removal for the ramp/hold sequence.
reset_timestep  0
velocity        all create ${Tstart} 12345 mom yes rot no dist gaussian bias yes temp Tcs
velocity        all create 5 12345 mom yes rot no dist gaussian bias yes temp Tcs
velocity        all scale  ${Tstart} temp Tcs
velocity        all scale  5 temp Tcs
fix             fmom all momentum 1000 linear 1 1 1
fix             nvt all nvt temp ${Tstart} ${Tstop} ${Tdamp} drag 1
fix             nvt all nvt temp 5 ${Tstop} ${Tdamp} drag 1
fix             nvt all nvt temp 5 5 ${Tdamp} drag 1
fix             nvt all nvt temp 5 5 0.05 drag 1
fix_modify      nvt temp Tcs

# ------------------------ RAMP 0 -> 12 GPa ----------------------------
fix             pushTop topPressCore addforce 0.0 0.0 v_FtopRamp
fix             pushBot botPressCore addforce 0.0 0.0 v_FbotRamp
run             ${RAMP_STEPS}
run             30000
