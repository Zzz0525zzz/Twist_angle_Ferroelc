LAMMPS (29 Sep 2021)
# =========================================================
# Twisted BaTiO3 bilayer: P12 long-hold surface-traction test
#
# Purpose:
#   Use the current DSF core-shell potential to test whether the interfacial
#   moire-correlated rotational polarization texture is stable during a longer
#   12 GPa normal-pressure hold.
#
# Current interpretation:
#   - twist already writes an interfacial rotational / vortex-like polar texture
#     into the 0 GPa relaxed structure;
#   - normal pressure should be treated as a tuning / amplification variable,
#     not as the fundamental origin of the texture;
#   - previous 8-16 GPa screening suggests 10-12 GPa is the useful window.
#
# Physical loading:
#   top outer surface:    downward traction
#   bottom outer surface: upward traction
#   net external force:   approximately zero
#   interface:            compressed by the two slabs being pressed together
#
# Main protocol:
#   1) read atomic.data;
#   2) small conservative pre-relaxation, with no dump output;
#   3) reset displacement reference;
#   4) ramp 0 -> 12 GPa;
#   5) hold at 12 GPa for a longer time;
#   6) write data/restart and dump frames for layer-resolved post-processing.
#
# Main outputs:
#   twist_bto_P12_longhold_start.data
#   twist_bto_P12_longhold_prerelax.data
#   twist_bto_P12_longhold_ramp_to_P12.data
#   twist_bto_P12_longhold_P12_longhold.data
#   twist_bto_P12_longhold_Load.*.dump
# =========================================================

# ------------------------ INITIALIZATION ----------------------------
units           metal
dimension       3
boundary        p p f
atom_style      full
atom_modify     map yes

timestep        0.0001

variable        DATAIN    string atomic.data
variable        CASE      string twist_bto_P12_longhold

# Keep large z vacuum to remove the z-periodic fake interface.
variable        ZLOBOX    equal 0.0
variable        ZHIBOX    equal 130.0

# Target pressure and timing.
# timestep = 0.0001 ps in metal units.
# RAMP_STEPS = 30000 -> 3 ps ramp.
# HOLD_STEPS = 100000 -> 10 ps hold.
# If this is too expensive, first test HOLD_STEPS = 50000.
variable        PTARGET_GPa equal 12.0
variable        RAMP_STEPS  equal 30000
variable        HOLD_STEPS  equal 100000

# Unit conversion: 1 eV/A^3 = 160.21766208 GPa.
variable        GPa_per_eVA3 equal 160.21766208

variable        Tstart    equal 5.0
variable        Tstop     equal 5.0
variable        Tdamp     equal 0.05
variable        THERMO    equal 1000
variable        DUMPINT   equal 5000

# ------------------------ FORCE FIELD STYLE BEFORE READ_DATA ----------------------------
# Define styles before read_data to tolerate data files written with pair/bond coeff sections.
dielectric      1.5
pair_style      born/coul/dsf/cs 0.1 8.0 10.0
bond_style      class2
special_bonds   coul 0.0 1.0 1.0

# ----------------------- ATOM DEFINITION ----------------------------
fix             csinfo all property/atom i_CSID
read_data       ${DATAIN} fix csinfo NULL CS-Info
read_data       atomic.data fix csinfo NULL CS-Info
Reading data file ...
  orthogonal box = (0.0000000 0.0000000 30.000000) to (88.362888 88.362888 71.000000)
  4 by 4 by 2 MPI processor grid
  reading atoms ...
  48800 atoms
  scanning bonds ...
  1 = max bonds/atom
  reading bonds ...
  24400 bonds
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        1        1       
     1 = max # of 1-2 neighbors
     0 = max # of 1-3 neighbors
     0 = max # of 1-4 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.003 seconds
  read_data CPU = 0.115 seconds
change_box      all z final ${ZLOBOX} ${ZHIBOX} units box
change_box      all z final 0 ${ZHIBOX} units box
change_box      all z final 0 130 units box
Changing box ...
  orthogonal box = (0.0000000 0.0000000 0.0000000) to (88.362888 88.362888 130.00000)

# Coefficients from the current DSF test potential.
pair_coeff      * * 0.0     1.000   0.0     0.0     0.0
pair_coeff      2 6 1061.30 0.3740  0.0     0.0     0.0     # Ba-O
pair_coeff      4 6 3769.93 0.2558  0.0     0.0     0.0     # Ti-O
pair_coeff      6 6 4740.00 0.2809  0.0     160.0   0.0     # O-O
pair_modify     table 0

bond_coeff      1 0.0 125.9 0.0 0.0
bond_coeff      2 0.0 161.0 0.0 20.83
bond_coeff      3 0.0 15.5  0.0 166.67

# ----------------------- GROUPS ----------------------------
group           Bacore    type 1
4880 atoms in group Bacore
group           Bashell   type 2
4880 atoms in group Bashell
group           Ticore    type 3
4880 atoms in group Ticore
group           Tishell   type 4
4880 atoms in group Tishell
group           Ocore     type 5
14640 atoms in group Ocore
group           Oshell    type 6
14640 atoms in group Oshell
group           cores     type 1 3 5
24400 atoms in group cores
group           shells    type 2 4 6
24400 atoms in group shells
group           BTO       type 1 2 3 4 5 6
48800 atoms in group BTO

# Static upper/lower slab groups. The interface lies around z~50 A.
region          lowerReg block INF INF INF INF INF 50.0 units box
region          upperReg block INF INF INF INF 50.0 INF units box
group           lower region lowerReg
24400 atoms in group lower
group           upper region upperReg
24400 atoms in group upper
group           lowerCore intersect lower cores
12200 atoms in group lowerCore
group           upperCore intersect upper cores
12200 atoms in group upperCore

# Symmetric outer-surface traction groups.
# These thresholds should give Ntop ~= Nbot for the current geometry.
# Only core atoms are directly loaded; shells respond through core-shell coupling.
variable        ZBOT_PRESS_MAX equal 33.0
variable        ZTOP_PRESS_MIN equal 66.0
region          botSurfReg block INF INF INF INF INF ${ZBOT_PRESS_MAX} units box
region          botSurfReg block INF INF INF INF INF 33 units box
region          topSurfReg block INF INF INF INF ${ZTOP_PRESS_MIN} INF units box
region          topSurfReg block INF INF INF INF 66 INF units box
group           botSurfAtoms region botSurfReg
4880 atoms in group botSurfAtoms
group           topSurfAtoms region topSurfReg
4880 atoms in group topSurfAtoms
group           botPressCore intersect botSurfAtoms cores
2440 atoms in group botPressCore
group           topPressCore intersect topSurfAtoms cores
2440 atoms in group topPressCore

# ----------------------- NEIGHBOR / COMM ----------------------------
neighbor        2.0 bin
comm_modify     vel yes cutoff 15.0
neigh_modify    delay 0 every 1 check yes

# ------------------------ COMPUTES -------------------------------
compute         myKE all ke/atom
compute         myPE all pe/atom
compute         stress all stress/atom NULL virial
compute         Tcs all temp/cs cores shells
compute         dis all displace/atom
compute         thermo_press_lmp all pressure Tcs
compute         cTop upper com
compute         cBot lower com
thermo_modify   temp Tcs press thermo_press_lmp lost error

variable        Mise atom (1/sqrt(2))*sqrt((c_stress[1]-c_stress[2])*(c_stress[1]-c_stress[2])+(c_stress[3]-c_stress[2])*(c_stress[3]-c_stress[2])+(c_stress[1]-c_stress[3])*(c_stress[1]-c_stress[3])+6*(c_stress[4]*c_stress[4]+c_stress[5]*c_stress[5]+c_stress[6]*c_stress[6]))

variable        zTopCOM equal c_cTop[3]
variable        zBotCOM equal c_cBot[3]
variable        sepCOM  equal v_zTopCOM-v_zBotCOM
variable        zUpperMin equal bound(upper,zmin)
variable        zLowerMax equal bound(lower,zmax)
variable        gapSurf equal v_zUpperMin-v_zLowerMax

# Surface pressure conversion to per-atom force.
# Total force on each surface = P * Axy.
# Per-atom force = P(GPa)/160.21766208 * lx*ly / N_surface_core.
variable        Axy    equal lx*ly
variable        Ntop   equal count(topPressCore)
variable        Nbot   equal count(botPressCore)

# Pressure-to-force conversion.
# Ramp variable is valid because reset_timestep 0 is used before loading.
variable        PrampTarget equal v_PTARGET_GPa*step/v_RAMP_STEPS
variable        FtopRamp    equal -v_PrampTarget/v_GPa_per_eVA3*v_Axy/v_Ntop
variable        FbotRamp    equal  v_PrampTarget/v_GPa_per_eVA3*v_Axy/v_Nbot

variable        FtopTarget  equal -v_PTARGET_GPa/v_GPa_per_eVA3*v_Axy/v_Ntop
variable        FbotTarget  equal  v_PTARGET_GPa/v_GPa_per_eVA3*v_Axy/v_Nbot

thermo          ${THERMO}
thermo          1000
thermo_style    custom step temp ke pe etotal press pzz v_sepCOM v_gapSurf v_zLowerMax v_zUpperMin v_Axy v_Ntop v_Nbot lx ly lz
WARNING: New thermo_style command, previous thermo_modify settings will be lost (../output.cpp:689)
thermo_modify   temp Tcs press thermo_press_lmp lost error

run             0
Neighbor list info ...
  update every 1 steps, delay 0 steps, check yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 12
  ghost atom cutoff = 15
  binsize = 6, bins = 15 15 22
  1 neighbor lists, perpetual/occasional/extra = 1 0 0
  (1) pair born/coul/dsf/cs, perpetual
      attributes: half, newton on
      pair build: half/bin/newton
      stencil: half/bin/3d
      bin: standard
