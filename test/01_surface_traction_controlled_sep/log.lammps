print           "Surface loading check: Ntop=${Ntop}, Nbot=${Nbot}; NupperCore=${NupperCore}, NlowerCore=${NlowerCore}."
Surface loading check: Ntop=2440, Nbot=2440; NupperCore=12200, NlowerCore=12200.
print           "If Ntop and Nbot differ strongly, tune ZTOP_PRESS_MIN / ZBOT_PRESS_MAX."
If Ntop and Nbot differ strongly, tune ZTOP_PRESS_MIN / ZBOT_PRESS_MAX.
write_data      ${CASE}_start.data pair ij
write_data      twist_bto_coupling_controlled_start.data pair ij
System init for write_data ...
write_restart   ${CASE}_start.restart
write_restart   twist_bto_coupling_controlled_start.restart
System init for write_restart ...

# ------------------------ SMALL PRE-RELAXATION ----------------------------
# No dump is written during this part. This avoids huge unnecessary output and
# keeps the later dump focused on the controlled pressure/unload/separation path.
fix             teth shells spring/self 0.05
fix_modify      teth energy yes
min_style       cg
min_modify      dmax 0.00010 line quadratic
minimize        0.0 1.0e-6 3000 30000
