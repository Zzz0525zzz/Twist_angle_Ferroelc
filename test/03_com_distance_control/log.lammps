write_data      twist_bto_C_com_distance_prerelax.data pair ij
System init for write_data ...
write_restart   ${CASE}_prerelax.restart
write_restart   twist_bto_C_com_distance_prerelax.restart
System init for write_restart ...

# Reset timestep and displacement reference after pre-relaxation.
reset_timestep  0
uncompute       dis
compute         dis all displace/atom

# ------------------------ FULL-PATH DUMP ----------------------------
dump            dpath all custom ${DUMPINT} ${CASE}_Path.*.dump id mol type q x y z fx fy fz c_dis[1] c_dis[2] c_dis[3] c_dis[4] c_myKE c_myPE v_Mise
dump            dpath all custom 5000 ${CASE}_Path.*.dump id mol type q x y z fx fy fz c_dis[1] c_dis[2] c_dis[3] c_dis[4] c_myKE c_myPE v_Mise
dump            dpath all custom 5000 twist_bto_C_com_distance_Path.*.dump id mol type q x y z fx fy fz c_dis[1] c_dis[2] c_dis[3] c_dis[4] c_myKE c_myPE v_Mise
dump_modify     dpath sort id first yes

velocity        all create ${Tstart} 12345 mom yes rot no dist gaussian bias yes temp Tcs
velocity        all create 5 12345 mom yes rot no dist gaussian bias yes temp Tcs
velocity        all scale  ${Tstart} temp Tcs
velocity        all scale  5 temp Tcs
fix             fmom all momentum 1000 linear 1 1 1
fix             nvt all nvt temp ${Tstart} ${Tstop} ${Tdamp} drag 1
fix             nvt all nvt temp 5 ${Tstop} ${Tdamp} drag 1
fix             nvt all nvt temp 5 5 ${Tdamp} drag 1
fix             nvt all nvt temp 5 5 0.05 drag 1
fix_modify      nvt temp Tcs

run             0
