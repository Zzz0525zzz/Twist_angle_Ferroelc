LAMMPS (29 Sep 2021)
# =========================================================
# Twisted BaTiO3 bilayer: Case C control
# COM-distance controlled compression/unload/separation
#
# Purpose:
#   Test whether changing the upper-lower slab separation, without directly
#   applying surface traction to the free surfaces, can reproduce the internal
#   moire-coupled polar texture. This is a geometry/interface-coupling control,
#   not a fixed-pressure loading.
#
# Important interpretation:
#   - COMPRESS_TOTAL_A controls the target reduction of upper-lower COM separation.
#   - Compare d56/sepCOM with the surface-traction baseline in post-processing.
#   - Forces are distributed over upper/lower core atoms as a COM-separation spring.
# =========================================================

# ------------------------ INITIALIZATION ----------------------------
units           metal
dimension       3
boundary        p p f
atom_style      full
atom_modify     map yes

timestep        0.0001

variable        DATAIN    string atomic.data
variable        CASE      string twist_bto_C_com_distance

variable        ZLOBOX    equal 0.0
variable        ZHIBOX    equal 130.0

# ------------------------ PATH PARAMETERS ----------------------------
# Total target reduction of upper-lower COM separation during compression.
# Start with 1.0 A and tune to match the baseline d56/sepCOM response.
variable        COMPRESS_TOTAL_A   equal 1.0
variable        KCOMP_COM          equal 200.0     # eV/A^2 total COM-compression spring stiffness

variable        RAMP_LOAD_STEPS    equal 30000
variable        HOLD_COMP_STEPS    equal 50000
variable        RAMP_UNLOAD_STEPS  equal 30000
variable        HOLD_P0_STEPS      equal 30000

# Controlled separation after P0 hold, using the same COM-separation logic.
variable        SEP_STEP_A         equal 2.0
variable        SEP_RAMP_STEPS     equal 20000
variable        SEP_HOLD_STEPS     equal 30000
variable        KSEP_COM           equal 200.0

variable        Tstart             equal 5.0
variable        Tstop              equal 5.0
variable        Tdamp              equal 0.05
variable        THERMO             equal 1000
variable        DUMPINT            equal 5000

# Absolute step offsets after reset_timestep 0.
variable        STEP_LOAD_START    equal 0
variable        STEP_COMP_START    equal v_RAMP_LOAD_STEPS
variable        STEP_UNLOAD_START  equal v_RAMP_LOAD_STEPS+v_HOLD_COMP_STEPS
variable        STEP_P0_START      equal v_STEP_UNLOAD_START+v_RAMP_UNLOAD_STEPS
variable        STEP_SEP_START     equal v_STEP_P0_START+v_HOLD_P0_STEPS

variable        STEP_SEP1_START    equal v_STEP_SEP_START
variable        STEP_SEP2_START    equal v_STEP_SEP_START+1*(v_SEP_RAMP_STEPS+v_SEP_HOLD_STEPS)
variable        STEP_SEP3_START    equal v_STEP_SEP_START+2*(v_SEP_RAMP_STEPS+v_SEP_HOLD_STEPS)
variable        STEP_SEP4_START    equal v_STEP_SEP_START+3*(v_SEP_RAMP_STEPS+v_SEP_HOLD_STEPS)
variable        STEP_SEP5_START    equal v_STEP_SEP_START+4*(v_SEP_RAMP_STEPS+v_SEP_HOLD_STEPS)

# ------------------------ FORCE FIELD STYLE BEFORE READ_DATA ----------------------------
dielectric      1.5
pair_style      born/coul/dsf/cs 0.1 8.0 10.0
bond_style      class2
special_bonds   coul 0.0 1.0 1.0

# ----------------------- ATOM DEFINITION ----------------------------
fix             csinfo all property/atom i_CSID
read_data       ${DATAIN} fix csinfo NULL CS-Info
read_data       atomic.data fix csinfo NULL CS-Info
Reading data file ...
  orthogonal box = (0.0000000 0.0000000 30.000000) to (88.362888 88.362888 71.000000)
  4 by 4 by 2 MPI processor grid
  reading atoms ...
  48800 atoms
  scanning bonds ...
  1 = max bonds/atom
  reading bonds ...
  24400 bonds
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        1        1       
     1 = max # of 1-2 neighbors
     0 = max # of 1-3 neighbors
     0 = max # of 1-4 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.003 seconds
  read_data CPU = 0.113 seconds
change_box      all z final ${ZLOBOX} ${ZHIBOX} units box
change_box      all z final 0 ${ZHIBOX} units box
change_box      all z final 0 130 units box
Changing box ...
  orthogonal box = (0.0000000 0.0000000 0.0000000) to (88.362888 88.362888 130.00000)

pair_coeff      * * 0.0     1.000   0.0     0.0     0.0
pair_coeff      2 6 1061.30 0.3740  0.0     0.0     0.0
pair_coeff      4 6 3769.93 0.2558  0.0     0.0     0.0
pair_coeff      6 6 4740.00 0.2809  0.0     160.0   0.0
pair_modify     table 0

bond_coeff      1 0.0 125.9 0.0 0.0
bond_coeff      2 0.0 161.0 0.0 20.83
bond_coeff      3 0.0 15.5  0.0 166.67

# ----------------------- GROUPS ----------------------------
group           Bacore    type 1
4880 atoms in group Bacore
group           Bashell   type 2
4880 atoms in group Bashell
group           Ticore    type 3
4880 atoms in group Ticore
group           Tishell   type 4
4880 atoms in group Tishell
group           Ocore     type 5
14640 atoms in group Ocore
group           Oshell    type 6
14640 atoms in group Oshell
group           cores     type 1 3 5
24400 atoms in group cores
group           shells    type 2 4 6
24400 atoms in group shells
group           BTO       type 1 2 3 4 5 6
48800 atoms in group BTO

region          lowerReg block INF INF INF INF INF 50.0 units box
region          upperReg block INF INF INF INF 50.0 INF units box
group           lower region lowerReg
24400 atoms in group lower
group           upper region upperReg
24400 atoms in group upper
group           lowerCore intersect lower cores
12200 atoms in group lowerCore
group           upperCore intersect upper cores
12200 atoms in group upperCore

# Optional surface monitor groups; not used for loading in this Case C.
variable        ZBOT_SURF_MAX equal 33.0
variable        ZTOP_SURF_MIN equal 66.0
region          botSurfReg block INF INF INF INF INF ${ZBOT_SURF_MAX} units box
region          botSurfReg block INF INF INF INF INF 33 units box
region          topSurfReg block INF INF INF INF ${ZTOP_SURF_MIN} INF units box
region          topSurfReg block INF INF INF INF 66 INF units box
group           botSurfAtoms region botSurfReg
4880 atoms in group botSurfAtoms
group           topSurfAtoms region topSurfReg
4880 atoms in group topSurfAtoms

# ----------------------- NEIGHBOR / COMM ----------------------------
neighbor        2.0 bin
comm_modify     vel yes cutoff 15.0
neigh_modify    delay 0 every 1 check yes

# ------------------------ COMPUTES -------------------------------
compute         myKE all ke/atom
compute         myPE all pe/atom
compute         stress all stress/atom NULL virial
compute         Tcs all temp/cs cores shells
compute         dis all displace/atom
compute         thermo_press_lmp all pressure Tcs
compute         cTop upper com
compute         cBot lower com
thermo_modify   temp Tcs press thermo_press_lmp lost error

variable        Mise atom (1/sqrt(2))*sqrt((c_stress[1]-c_stress[2])*(c_stress[1]-c_stress[2])+(c_stress[3]-c_stress[2])*(c_stress[3]-c_stress[2])+(c_stress[1]-c_stress[3])*(c_stress[1]-c_stress[3])+6*(c_stress[4]*c_stress[4]+c_stress[5]*c_stress[5]+c_stress[6]*c_stress[6]))

variable        zTopCOM       equal c_cTop[3]
variable        zBotCOM       equal c_cBot[3]
variable        sepCOM        equal v_zTopCOM-v_zBotCOM
variable        zUpperMin     equal bound(upper,zmin)
variable        zLowerMax     equal bound(lower,zmax)
variable        gapSurf       equal v_zUpperMin-v_zLowerMax
variable        Axy           equal lx*ly
variable        NupperCore    equal count(upperCore)
variable        NlowerCore    equal count(lowerCore)

thermo          ${THERMO}
thermo          1000
thermo_style    custom step temp ke pe etotal press pzz v_sepCOM v_gapSurf v_zLowerMax v_zUpperMin v_Axy v_NupperCore v_NlowerCore lx ly lz
WARNING: New thermo_style command, previous thermo_modify settings will be lost (../output.cpp:689)
thermo_modify   temp Tcs press thermo_press_lmp lost error

run             0
