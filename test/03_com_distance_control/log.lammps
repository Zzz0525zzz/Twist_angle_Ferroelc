# ------------------------ STAGE 2: HOLD COMPRESSED COM DISTANCE ----------------------------
variable        sepTargetComp equal v_SEP0_LOAD-v_COMPRESS_TOTAL_A
variable        sepErrorComp  equal v_sepTargetComp-v_sepCOM
variable        FupComp       equal  v_KCOMP_COM*v_sepErrorComp/v_NupperCore
variable        FloComp       equal -v_KCOMP_COM*v_sepErrorComp/v_NlowerCore
print           "Stage 2: hold compressed COM distance."
Stage 2: hold compressed COM distance.
fix             compUp upperCore addforce 0.0 0.0 v_FupComp
fix             compLo lowerCore addforce 0.0 0.0 v_FloComp
run             ${HOLD_COMP_STEPS}
