print           "COM-distance control check: NupperCore=${NupperCore}, NlowerCore=${NlowerCore}."
COM-distance control check: NupperCore=12200, NlowerCore=12200.
write_data      ${CASE}_start.data pair ij
write_data      twist_bto_C_com_distance_start.data pair ij
System init for write_data ...
write_restart   ${CASE}_start.restart
write_restart   twist_bto_C_com_distance_start.restart
System init for write_restart ...

# ------------------------ SMALL PRE-RELAXATION ----------------------------
fix             teth shells spring/self 0.05
fix_modify      teth energy yes
min_style       cg
min_modify      dmax 0.00010 line quadratic
minimize        0.0 1.0e-6 3000 30000
