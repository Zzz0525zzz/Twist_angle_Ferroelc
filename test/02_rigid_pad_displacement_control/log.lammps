# ------------------------ STAGE 1: RIGID-PAD COMPRESSION RAMP ----------------------------
# IMPORTANT: use immediate ${...} expansion because some LAMMPS versions do not
# accept v_name variables in fix move linear.
print           "Stage 1: rigid-pad compression ramp. COMPRESS_TOTAL_A=${COMPRESS_TOTAL_A} A. Expected final step = ${STEP_COMP_END}."
Stage 1: rigid-pad compression ramp. COMPRESS_TOTAL_A=1 A. Expected final step = 30000.
fix             moveTop topPad move linear 0.0 0.0 ${VtopLoad} units box
fix             moveTop topPad move linear 0.0 0.0 -0.166666666666667 units box
fix             moveBot botPad move linear 0.0 0.0 ${VbotLoad} units box
fix             moveBot botPad move linear 0.0 0.0 0.166666666666667 units box
run             ${RAMP_LOAD_STEPS}
run             30000
