# Reset timestep and displacement reference once, after pre-relaxation.
reset_timestep  0
uncompute       dis
compute         dis all displace/atom

# ------------------------ FULL-PATH DUMP ----------------------------
dump            dpath all custom ${DUMPINT} ${CASE}_Path.*.dump id mol type q x y z fx fy fz c_dis[1] c_dis[2] c_dis[3] c_dis[4] c_myKE c_myPE v_Mise
dump            dpath all custom 5000 ${CASE}_Path.*.dump id mol type q x y z fx fy fz c_dis[1] c_dis[2] c_dis[3] c_dis[4] c_myKE c_myPE v_Mise
dump            dpath all custom 5000 twist_bto_B_rigid_pad_Path.*.dump id mol type q x y z fx fy fz c_dis[1] c_dis[2] c_dis[3] c_dis[4] c_myKE c_myPE v_Mise
dump_modify     dpath sort id first yes

# Mobile atoms are integrated. Rigid pads are NOT integrated by NVT.
velocity        mobile create ${Tstart} 12345 mom yes rot no dist gaussian bias yes temp Tcs
velocity        mobile create 5 12345 mom yes rot no dist gaussian bias yes temp Tcs
velocity        mobile scale  ${Tstart} temp Tcs
velocity        mobile scale  5 temp Tcs
velocity        topPad set 0.0 0.0 0.0
velocity        botPad set 0.0 0.0 0.0
fix             fmom mobile momentum 1000 linear 1 1 1
fix             nvt mobile nvt temp ${Tstart} ${Tstop} ${Tdamp} drag 1
fix             nvt mobile nvt temp 5 ${Tstop} ${Tdamp} drag 1
fix             nvt mobile nvt temp 5 5 ${Tdamp} drag 1
fix             nvt mobile nvt temp 5 5 0.05 drag 1
fix_modify      nvt temp Tcs
