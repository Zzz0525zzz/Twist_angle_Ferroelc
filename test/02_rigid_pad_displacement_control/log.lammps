LAMMPS (29 Sep 2021)
# =========================================================
# Twisted BaTiO3 bilayer: Case B control
# Rigid sacrificial loading-pad displacement control
#
# Purpose:
#   Test whether the internal moire-coupled 3D polar texture survives when the
#   outer loading layers are treated as sacrificial rigid pads instead of using
#   direct core-only surface traction.
#
# Key idea:
#   - bottom pad and top pad include BOTH core and shell atoms in the outermost
#     loading layers;
#   - pads are moved symmetrically by prescribed displacement using fix move;
#   - mobile atoms between the pads are integrated by NVT with temp/cs;
#   - pad layers are artificial loading fixtures and must be excluded from
#     polarization/topology conclusions.
#
# Important LAMMPS compatibility note:
#   fix move linear in some LAMMPS versions does NOT accept v_name variables
#   directly. Therefore all pad velocities are immediately expanded with ${...}
#   into floating-point numbers when each fix move command is defined.
#
# Physical path:
#   1) read atomic.data;
#   2) conservative pre-relaxation;
#   3) reset timestep once and reset displacement reference;
#   4) full-path dump starts at post-pre-relax reference state;
#   5) rigid-pad symmetric displacement compression;
#   6) compressed hold;
#   7) rigid-pad symmetric displacement unload back to the reference pad spacing;
#   8) P0 hold.
#
# Main outputs:
#   twist_bto_B_rigid_pad_start.data
#   twist_bto_B_rigid_pad_prerelax.data
#   twist_bto_B_rigid_pad_path_initial.data
#   twist_bto_B_rigid_pad_compressed.data
#   twist_bto_B_rigid_pad_compressed_hold.data
#   twist_bto_B_rigid_pad_unloaded.data
#   twist_bto_B_rigid_pad_P0_hold.data
#   twist_bto_B_rigid_pad_Path.*.dump
# =========================================================

# ------------------------ INITIALIZATION ----------------------------
units           metal
dimension       3
boundary        p p f
atom_style      full
atom_modify     map yes

timestep        0.0001

variable        DATAIN              string atomic.data
variable        CASE                string twist_bto_B_rigid_pad

# Keep large z vacuum.
variable        ZLOBOX              equal 0.0
variable        ZHIBOX              equal 130.0

# ------------------------ PATH PARAMETERS ----------------------------
# timestep = 0.0001 ps.
# COMPRESS_TOTAL_A is the total reduction of the top-pad/bottom-pad separation.
# Each pad moves by COMPRESS_TOTAL_A/2.
variable        TS                  equal 0.0001
variable        COMPRESS_TOTAL_A    equal 1.0
variable        RAMP_LOAD_STEPS     equal 30000
variable        HOLD_COMP_STEPS     equal 50000
variable        RAMP_UNLOAD_STEPS   equal 30000
variable        HOLD_P0_STEPS       equal 30000

variable        Tstart              equal 5.0
variable        Tstop               equal 5.0
variable        Tdamp               equal 0.05
variable        THERMO              equal 1000
variable        DUMPINT             equal 5000

# Unit conversion: 1 eV/A^3 = 160.21766208 GPa.
variable        GPa_per_eVA3        equal 160.21766208

# Rigid pad velocities in A/ps.
# During compression: top moves downward, bottom moves upward.
# During unloading: top moves upward, bottom moves downward.
variable        VpadMag             equal v_COMPRESS_TOTAL_A/(2.0*v_RAMP_LOAD_STEPS*v_TS)
variable        VtopLoad            equal -v_VpadMag
variable        VbotLoad            equal  v_VpadMag
variable        VtopUnload          equal  v_COMPRESS_TOTAL_A/(2.0*v_RAMP_UNLOAD_STEPS*v_TS)
variable        VbotUnload          equal -v_COMPRESS_TOTAL_A/(2.0*v_RAMP_UNLOAD_STEPS*v_TS)

# Step markers for monitoring only. No reset_timestep after the formal path starts.
variable        STEP_COMP_END       equal v_RAMP_LOAD_STEPS
variable        STEP_UNLOAD_START   equal v_RAMP_LOAD_STEPS+v_HOLD_COMP_STEPS
variable        STEP_P0_START       equal v_STEP_UNLOAD_START+v_RAMP_UNLOAD_STEPS
variable        STEP_END            equal v_STEP_P0_START+v_HOLD_P0_STEPS

# ------------------------ FORCE FIELD STYLE BEFORE READ_DATA ----------------------------
# Define styles before read_data to tolerate data files written with pair/bond coeff sections.
dielectric      1.5
pair_style      born/coul/dsf/cs 0.1 8.0 10.0
bond_style      class2
special_bonds   coul 0.0 1.0 1.0

# ----------------------- ATOM DEFINITION ----------------------------
fix             csinfo all property/atom i_CSID
read_data       ${DATAIN} fix csinfo NULL CS-Info
read_data       atomic.data fix csinfo NULL CS-Info
Reading data file ...
  orthogonal box = (0.0000000 0.0000000 30.000000) to (88.362888 88.362888 71.000000)
  4 by 4 by 2 MPI processor grid
  reading atoms ...
  48800 atoms
  scanning bonds ...
  1 = max bonds/atom
  reading bonds ...
  24400 bonds
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        1        1       
     1 = max # of 1-2 neighbors
     0 = max # of 1-3 neighbors
     0 = max # of 1-4 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.003 seconds
  read_data CPU = 0.114 seconds
change_box      all z final ${ZLOBOX} ${ZHIBOX} units box
change_box      all z final 0 ${ZHIBOX} units box
change_box      all z final 0 130 units box
Changing box ...
  orthogonal box = (0.0000000 0.0000000 0.0000000) to (88.362888 88.362888 130.00000)

# Coefficients from the current DSF test potential.
pair_coeff      * * 0.0     1.000   0.0     0.0     0.0
pair_coeff      2 6 1061.30 0.3740  0.0     0.0     0.0     # Ba-O
pair_coeff      4 6 3769.93 0.2558  0.0     0.0     0.0     # Ti-O
pair_coeff      6 6 4740.00 0.2809  0.0     160.0   0.0     # O-O
pair_modify     table 0

bond_coeff      1 0.0 125.9 0.0 0.0
bond_coeff      2 0.0 161.0 0.0 20.83
bond_coeff      3 0.0 15.5  0.0 166.67

# ----------------------- BASIC GROUPS ----------------------------
group           Bacore      type 1
4880 atoms in group Bacore
group           Bashell     type 2
4880 atoms in group Bashell
group           Ticore      type 3
4880 atoms in group Ticore
group           Tishell     type 4
4880 atoms in group Tishell
group           Ocore       type 5
14640 atoms in group Ocore
group           Oshell      type 6
14640 atoms in group Oshell
group           cores       type 1 3 5
24400 atoms in group cores
group           shells      type 2 4 6
24400 atoms in group shells
group           BTO         type 1 2 3 4 5 6
48800 atoms in group BTO

# Static upper/lower slab groups for monitoring. The initial interface is around z~50 A.
region          lowerReg block INF INF INF INF INF 50.0 units box
region          upperReg block INF INF INF INF 50.0 INF units box
group           lower region lowerReg
24400 atoms in group lower
group           upper region upperReg
24400 atoms in group upper
group           lowerCore intersect lower cores
12200 atoms in group lowerCore
group           upperCore intersect upper cores
12200 atoms in group upperCore

# ----------------------- RIGID SACRIFICIAL LOADING PADS ----------------------------
# These thresholds are chosen to select approximately the outermost unit-cell layer.
# Pads include BOTH cores and shells, and are moved by fix move as rigid loading fixtures.
# Pad atoms are NOT integrated by NVT. They should be excluded from physical analysis.
variable        ZBOT_PAD_MAX equal 33.0
variable        ZTOP_PAD_MIN equal 66.0
region          botPadReg block INF INF INF INF INF ${ZBOT_PAD_MAX} units box
region          botPadReg block INF INF INF INF INF 33 units box
region          topPadReg block INF INF INF INF ${ZTOP_PAD_MIN} INF units box
region          topPadReg block INF INF INF INF 66 INF units box
group           botPad region botPadReg
4880 atoms in group botPad
group           topPad region topPadReg
4880 atoms in group topPad
group           mobile subtract all botPad topPad
39040 atoms in group mobile
group           mobileCores intersect mobile cores
19520 atoms in group mobileCores
group           mobileShells intersect mobile shells
19520 atoms in group mobileShells

# ----------------------- NEIGHBOR / COMM ----------------------------
neighbor        2.0 bin
comm_modify     vel yes cutoff 15.0
neigh_modify    delay 0 every 1 check yes

# ------------------------ COMPUTES -------------------------------
compute         myKE all ke/atom
compute         myPE all pe/atom
compute         stress all stress/atom NULL virial
compute         Tcs mobile temp/cs mobileCores mobileShells
compute         dis all displace/atom
compute         thermo_press_lmp all pressure Tcs
compute         cTop upper com
compute         cBot lower com
compute         cTopPad topPad com
compute         cBotPad botPad com
compute         fTopPad topPad reduce sum fz
compute         fBotPad botPad reduce sum fz

variable        Mise atom (1/sqrt(2))*sqrt((c_stress[1]-c_stress[2])*(c_stress[1]-c_stress[2])+(c_stress[3]-c_stress[2])*(c_stress[3]-c_stress[2])+(c_stress[1]-c_stress[3])*(c_stress[1]-c_stress[3])+6*(c_stress[4]*c_stress[4]+c_stress[5]*c_stress[5]+c_stress[6]*c_stress[6]))

# Geometry monitors.
variable        Axy             equal lx*ly
variable        zTopCOM         equal c_cTop[3]
variable        zBotCOM         equal c_cBot[3]
variable        sepCOM          equal v_zTopCOM-v_zBotCOM
variable        zTopPadCOM      equal c_cTopPad[3]
variable        zBotPadCOM      equal c_cBotPad[3]
variable        padSepCOM       equal v_zTopPadCOM-v_zBotPadCOM
variable        zTopPadMin      equal bound(topPad,zmin)
variable        zBotPadMax      equal bound(botPad,zmax)
variable        padGap          equal v_zTopPadMin-v_zBotPadMax
variable        zUpperMin       equal bound(upper,zmin)
variable        zLowerMax       equal bound(lower,zmax)
variable        gapSurf         equal v_zUpperMin-v_zLowerMax
variable        NtopPad         equal count(topPad)
variable        NbotPad         equal count(botPad)
variable        Nmobile         equal count(mobile)
variable        NmobileCore     equal count(mobileCores)
variable        NmobileShell    equal count(mobileShells)

# Approximate reaction-pressure monitors from interaction forces acting on pads.
# Signs are only for monitoring; compare trends, not absolute sign conventions.
variable        PtopPadGPa      equal -c_fTopPad/v_Axy*v_GPa_per_eVA3
variable        PbotPadGPa      equal  c_fBotPad/v_Axy*v_GPa_per_eVA3

thermo          ${THERMO}
thermo          1000
thermo_style    custom step temp ke pe etotal press pzz v_sepCOM v_padSepCOM v_padGap v_gapSurf v_PtopPadGPa v_PbotPadGPa v_NtopPad v_NbotPad v_Nmobile v_NmobileCore v_NmobileShell lx ly lz
thermo_modify   temp Tcs press thermo_press_lmp lost error
WARNING: Temperature for thermo pressure is not for group all (../thermo.cpp:482)

run             0
